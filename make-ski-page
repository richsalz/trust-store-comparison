#! /usr/bin/env perl -w
use strict;
use warnings;


## Open the file, and if a Subject Key Identifier is there, return
## the next line, else return undef.
sub
get_ski()
{
    my ( $file ) = pop;
    open my $fh, '<', $file || die "Can't parse $file, $!";
    my @lines = <$fh>;
    close $fh;

    foreach my $idx (0 .. $#lines) {
	if ( $lines[$idx] =~ /X509v3 Subject Key/ ) {
	    my $ret = $lines[$idx + 1];
	    $ret =~ s/[ \t\r\n]//g;
	    return $ret;
	}
    }
    return undef

}

sub
get_issuer()
{
    my ( $file ) = pop;
    open my $fh, '<', $file || die "Can't parse $file, $!";
    my @lines = <$fh>;
    close $fh;

    foreach my $idx (0 .. $#lines) {
	if ( $lines[$idx] =~ /Issuer:/ ) {
	    my $ret = $lines[$idx];
	    $ret =~ s/Issuer:\s*//;
	    return $ret;
	}
    }
    return undef
}

