my @trusted;
foreach my $file ( @akamai ) {
    push @trusted, get_issuer($file);
}

foreach my $n ( sort @trusted ) {
    my $file = "all/" . $n2f{$n};
    my $lines = `openssl x509 -noout -fingerprint -serial -enddate -in $file`;
    $lines =~ s/SHA1 Fingerprint=/  - Fingerprint /;
    $lines =~ s/serial=/  - Serial: /;
    $lines =~ s/notAfter=/  - Expires: /;
    my $link = "${CRTSH}" . $n2f{$n};
    print "- Name: [$n]($link)\n$lines\n";
}

