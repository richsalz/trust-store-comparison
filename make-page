sub format_line {
    my $cert = shift;
    my $iss = shift;
    return "<li><a target=\"_blank\" href=\"${CRTSH}${cert}\">${iss}</a></br>\n";
}
sub format_list {
    my $hash_ref = shift;
    my %list = %{ $hash_ref };
    my @names = values %list;
    my $count = scalar @names;

    if ( $count == 0 ) {
	print "<p>None found.</p>\n";
	return;
    }
    print "<p>Number of certs = $count</p>\n";
    print "<ul>\n";
    foreach my $n ( sort @names ) {
	print "<li>"
	    . "<a target=\"_blank\" href=\"${CRTSH}$n2f{$n}\">${n}</a>"
	    . "</br></li>\n";
    }
    print "</ul>\n";
}

if ( $misscount != 0 ) {
    print "<h2 id='missing'>Missing Summary</h2>\n";
